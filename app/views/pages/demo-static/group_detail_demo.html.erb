<div class="flex">
  <aside class="h-screen w-55 bg-base-200 flex flex-col">
    <div class="h-14 p-3">
      アプリタイトル
    </div>

    <div class="p-3 flex flex-col gap-1.5 border-t border-neutral border-1">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-base-content/60 text-xs flex-1">
          自分のグループ
        </h2>
      </div>

      <ul class="menu bg-base-200 rounded-box w-full p-0">
        <% [
          {
            name: "ユーザー名",
            active: false,
            href: "#"
          }, 
        ].each do |item| %>
          <li>
            <a
              class="<%= 'menu-active' if item[:active] %>"
              href="<%= item[:href] %>"
            >
              <span class="badge badge-xs <%= item[:active] ? 'badge-primary' : 'badge-soft' %>"></span>
              <%= item[:name] %>
            </a>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="p-3 flex flex-col flex-1 gap-1.5 border-t border-neutral border-1">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-base-content/60 text-xs flex-1">
          グループ
        </h2>

        <button
          class="btn btn-circle btn-xs text-base-content/60 p-0 text-xs"
          onClick="console.log('add group')"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 4.5v15m7.5-7.5h-15"
            />
          </svg>
        </button>
      </div>

      <ul class="menu bg-base-200 rounded-box w-full p-0">
        <% [
          {
            name: "Item 1",
            active: true,
            href: "#"
          }, 
          {
            name: "Item 2",
            active: false,
            href: "#"
          }, 
          {
            name: "Item 3",
            active: false,
            href: "#"
          }
        ].each do |item| %>
          <li>
            <a
              class="<%= 'menu-active' if item[:active] %>"
              href="<%= item[:href] %>"
            >
              <span class="badge badge-xs <%= item[:active] ? 'badge-primary' : 'badge-soft' %>"></span>
              <%= item[:name] %>
            </a>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="p-3 flex items-center gap-2.5 border-t border-neutral border-1">
      <div class="avatar avatar-placeholder">
        <div class="bg-neutral text-neutral-content w-8 rounded-full">
          <span>SY</span>
        </div>
      </div>

      <div class="flex flex-col flex-1">
        <span class="font-bold text-sm">ユーザー名</span>
        <span class="text-sm text-base-content/60 text-xs">test@example.com</span>
      </div>

      <button
        class="btn btn-circle btn-xs text-base-content/60 p-0 text-xs"
        onClick="console.log('logout')"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
          />
        </svg>
      </button>
    </div>
  </aside>

  <div class="divider divider-horizontal divider-neutral m-0 w-0"></div>

  <div class="flex-1">
    <span>hello world</span>
  </div>
</div>
