<div class="flex items-center justify-between">
  <h2 class="font-bold text-base-content/60 text-xs flex-1">
    <%= title %>
  </h2>

  <%= end_adornment %>
</div>

<ul class="menu bg-base-200 rounded-box w-full p-0">
  <% groups.each do |item| %>
    <li>
      <a
        class="<%= 'menu-active' if item[:active] %>"
        href="<%= item[:href] %>"
      >
        <span class="badge badge-xs <%= item[:active] ? 'badge-primary' : 'badge-soft' %>"></span>
        <%= item[:name] %>
      </a>
    </li>
  <% end %>
</ul>
