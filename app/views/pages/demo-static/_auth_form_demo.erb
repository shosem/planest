<form class="flex flex-col gap-2">
  <!-- 新規登録の時のみ表示 -->
  <% if is_sign_up %>
    <%= render "pages/demo-static/label_wrapper_demo", label: "名前", id: "name" do |id| %>
      <input
        id="<%= id %>"
        autocomplete="name"
        type="text"
        placeholder="山田 太郎"
        name="name"
        class="input w-full"
      >
    <% end %>
  <% end %>

  <%= render "pages/demo-static/label_wrapper_demo", label: "メールアドレス", id: "email" do |id| %>
    <input
      id="<%= id %>"
      autocomplete="email"
      type="email"
      placeholder="you@example.com"
      name="email"
      class="input w-full"
    >
  <% end %>

  <%= render "pages/demo-static/label_wrapper_demo", label: "パスワード", id: "password" do |id| %>
    <input
      type="password"
      placeholder="*********"
      id="<%= id %>"
      autocomplete="current-password"
      name="password"
      class="input w-full"
    >
  <% end %>

  <!-- 新規登録の時のみ表示 -->
  <% if is_sign_up %>
    <%= render "pages/demo-static/label_wrapper_demo", label: "パスワード確認", id: "password_confirmation" do |id| %>
      <input
        type="password"
        placeholder="*********"
        id="<%= id %>"
        autocomplete="current-password"
        name="password_confirmation"
        class="input w-full"
      >
    <% end %>
  <% end %>

  <button type="submit" class="btn btn-primary btn-block">
    アカウント作成
  </button>
</form>
