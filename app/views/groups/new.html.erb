<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center">
    <div class="flex flex-col gap-2 w-[50%] max-w-md bg-base-100 p-6 rounded-2xl">
      <h3 class="text-lg font-bold">グループを作成</h3>

      <% if @group.errors.any? %>
        <p class="alert alert-error alert-soft">グループを作成できませんでした</p>
      <% end %>

      <%= form_with model: @group, data: { turbo_frame: "_top" }, class: "flex flex-col gap-2" do |f| %>
        <%= render "shared/input_field_layout", errors: @group.errors.full_messages_for(:name) do |field_class| %>
          <%= f.label :name, class: "label" %>
          <%= f.text_field :name, autocomplete: "off", placeholder: "デザイングループ", class: "input input-bordered w-full #{field_class}" %>
        <% end %>

        <div class="flex justify-end mt-2 gap-2">
          <%= f.submit "作成する", class: "btn btn-primary" %>

          <%= link_to "キャンセル", :back, data: { turbo_frame: "_top" }, class: "btn btn-outline" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
