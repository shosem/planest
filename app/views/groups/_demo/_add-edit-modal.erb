<dialog id="group_add_edit_modal" class="modal">
  <div class="modal-box flex flex-col gap-2">
    <h3 class="text-lg font-bold">グループを作成</h3>

    <form class="flex flex-col gap-2">
      <div class="flex flex-col gap-1">
        <!-- この下のlabelとinputはパーシャル化するかも -->
        <label for="group_name" class="label">グループ名</label>

        <input
          type="text"
          id="group_name"
          name="group_name"
          autocomplete="off"
          class="input input-bordered w-full"
          placeholder="例：デザインチーム"
          defaultValue=""
        >
      </div>

      <div class="flex gap-2">
        <button class="btn btn-outline flex-1">
          キャンセル
        </button>

        <button class="btn btn-primary flex-1" type="submit">
          作成する
        </button>
      </div>
    </form>
  </div>
</dialog>
