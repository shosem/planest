<dialog id="add_edit_modal" class="modal">
  <div class="modal-box flex flex-col gap-2">
    <h3 class="text-lg font-bold">グループを作成</h3>

    <form id="add_group_form" class="flex flex-col gap-1">
      <!-- この下のlabelとinputはパーシャル化するかも -->
      <label for="group_name" class="label">グループ名</label>

      <input
        type="text"
        id="group_name"
        name="group_name"
        autocomplete="off"
        class="input input-bordered w-full"
        placeholder="例：デザインチーム"
        required
        defaultValue=""
      >
    </form>

    <div class="modal-action m-0">
      <button class="btn btn-outline">キャンセル</button>
      <button class="btn btn-primary">作成する</button>
    </div>
  </div>
</dialog>
