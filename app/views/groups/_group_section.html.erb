<%# locals: (title:, groups:, mode:) %>

<div class="flex items-center justify-between">
  <h2 class="font-bold text-base-content/60 text-xs flex-1">
    <%= title %>
  </h2>

  <% if mode == :shared %>
    <%= link_to new_group_path, data: { turbo_frame: "modal" }, class: "btn btn-circle btn-xs text-base-content/60 p-0 text-xs" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15"
        />
      </svg>
    <% end %>
  <% end %>
</div>

<ul class="menu bg-base-200 rounded-box w-full p-0">
  <% if groups.empty? %>
    <li class="menu-disabled"><span>まだありません</span></li>
  <% end %>

  <% groups.each do |group| %>
    <% active = group == current_group %>

    <li>
      <div class="join p-0 gap-0">
        <%= link_to group_path(group), class: "btn btn-sm join-item flex-1 flex items-center gap-1 #{"btn-neutral" if active}", role: "button" do %>
          <div class="min-w-0 flex-1 flex items-center gap-1">
            <div
              aria-label="Status"
              class="status <%= active ? 'status-primary' : '' %>"
            ></div>

            <%= group.name %>
          </div>
        <% end %>

        <button
          class="btn btn-sm join-item <%= "btn-neutral" if active %>"
          popovertarget="group-menu-popover"
        >
          <%= render "shared/icons/ellipsis_horizontal_circle", class_name: "size-5" %>
        </button>
      </div>

      <div
        class="megamenu max-sm:megamenu-vertical w-fit overflow-visible"
        id="group-menu-popover"
        popover
      >
        <span class="megamenu-active"></span>

        <div id="b1" popover>
          <ul class="menu">
            <li>
              <!-- 以下はbutton_toもしくはlink_toに置き換えてください -->
              <a href="link-copy" class="justify-between">
                招待リンクをコピーする
                <%= render "shared/icons/clipboard_document", class_name: "size-4" %>
              </a>
            </li>

            <li>
              <!-- 以下はbutton_toもしくはlink_toに置き換えてください -->
              <a href="group-delete" class="justify-between">
                グループを削除する
                <%= render "shared/icons/trash", class_name: "size-4" %>
              </a>
            </li>
          </ul>

          <div class="divider my-0!"></div>

          <div class="p-4 pb-2 text-xs opacity-60 tracking-wide">
            グループメンバー一覧
          </div>

          <ul class="list bg-base-100 rounded-box shadow-md">
            <li class="list-row">Dio Lupa</li>

            <li class="list-row">Ellie Beilish</li>

            <li class="list-row">Sabrino Gardener</li>
          </ul>
        </div>
      </div>
    </li>
  <% end %>
</ul>
