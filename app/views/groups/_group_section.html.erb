<%# locals: (title:, groups:, mode:) %>

<div class="flex items-center justify-between">
  <h2 class="font-bold text-base-content/60 text-xs flex-1">
    <%= title %>
  </h2>

  <% if mode == :shared %>
    <button class="btn btn-circle btn-xs text-base-content/60 p-0 text-xs">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15"
        />
      </svg>
    </button>
  <% end %>
</div>

<ul class="menu bg-base-200 rounded-box w-full p-0">
  <% if groups.empty? %>
    <li class="menu-disabled"><span>まだありません</span></li>
  <% end %>

  <% groups.each do |group| %>
    <% active = group == current_group %>

    <li>
      <div class="join p-0 gap-0">
        <%= link_to group_path(group), class: "btn join-item flex-1 flex items-center gap-1 #{"btn-neutral" if active}", role: "button" do %>
          <div class="min-w-0 flex-1 flex items-center gap-1">
            <div
              aria-label="Status"
              class="status <%= active ? 'status-primary' : '' %>"
            ></div>

            <%= group.name %>
          </div>
        <% end %>

        <button
          class="btn join-item <%= "btn-neutral" if active %>"
          popovertarget="group-menu-popover"
        >
          <%= render "shared/icons/ellipsis_horizontal_circle", class_name: "size-5" %>
        </button>
      </div>

      <div
        class="
          megamenu max-sm:megamenu-vertical megamenu-wide p-2 border
          border-base-300
        "
        id="group-menu-popover"
        popover
      >
        <span class="megamenu-active"></span>

        <div id="b1" popover>
          <ul class="menu menu-horizontal">
            <li><a>Enterprise</a></li>
            <li><a>CRM software</a></li>
            <li><a>Security</a></li>
            <li><a>Consulting</a></li>
          </ul>
        </div>

        <div id="b2" popover>
          <ul class="menu menu-horizontal">
            <li><a>AI infrastructure</a></li>
            <li><a>Image generation</a></li>
            <li><a>MCP servers</a></li>
          </ul>
        </div>

        <div id="b3" popover>
          <ul class="menu menu-horizontal">
            <li><a>Cloud computing</a></li>
            <li><a>Storage solutions</a></li>
            <li><a>Database services</a></li>
            <li><a>CDN performance</a></li>
          </ul>
        </div>
      </div>
    </li>
  <% end %>
</ul>
