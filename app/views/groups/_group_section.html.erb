<%# locals: (title:, groups:, mode:) %>

<% shared = mode == :shared %>

<div class="flex items-center justify-between">
  <h2 class="font-bold text-base-content/60 text-xs flex-1">
    <%= title %>
  </h2>

  <% if shared %>
    <%= link_to new_group_path, data: { turbo_frame: "modal" }, class: "btn btn-circle btn-xs text-base-content/60 p-0 text-xs" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15"
        />
      </svg>
    <% end %>
  <% end %>
</div>

<ul class="menu bg-base-200 rounded-box w-full p-0">
  <% if groups.empty? %>
    <li class="menu-disabled"><span>まだありません</span></li>
  <% end %>

  <% groups.each do |group| %>
    <% active = group == current_group %>
    <% popover_id = "group-menu-popover-#{group.id}" %>

    <li>
      <div class="join p-0 gap-0">
        <%= link_to group_path(group), class: "btn btn-sm join-item flex-1 flex items-center gap-1 #{"btn-neutral" if active}", role: "button" do %>
          <div class="min-w-0 flex-1 flex items-center gap-1">
            <div
              aria-label="Status"
              class="status <%= active ? 'status-primary' : '' %>"
            ></div>

            <%= group.name %>
          </div>
        <% end %>

        <% if shared %>
          <button
            class="btn btn-sm join-item <%= "btn-neutral" if active %>"
            popovertarget="<%= popover_id %>"
          >
            <%= render "shared/icons/ellipsis_horizontal_circle", class_name: "size-5" %>
          </button>
        <% end %>
      </div>

      <%# ポップオーバー %>
      <% if shared %>
        <%# _pathはjoin/:invite_code、_urlはURL全体を取得 %>
        <%= render "groups/popover", group: group, id: popover_id %>
      <% end %>
    </li>
  <% end %>
</ul>
