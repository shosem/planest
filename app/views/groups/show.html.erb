<div class="flex flex-col">
  <header class="pt-8 pb-5 w-2xl mx-auto flex justify-between items-center">
    <!-- グループが作成されている場合のみ -->
    <% if @group.present? %>
      <div>
        <h1 class="font-bold text-4xl"><%= @group.name %></h1>
        <p class="text-gray-600 text-gray">n件のタスク</p>
      </div>
    <% end %>

    <%= link_to new_group_task_path(@group), data: { turbo_frame: "modal" }, class: "btn btn-primary" do %>
      <%= render "shared/icons/plus", class_name: "size-3" %> タスク追加
    <% end %>
  </header>
</div>
