<div class="h-screen flex flex-col">
  <header class="pt-8 pb-5 w-2xl mx-auto flex justify-between items-center">
    <!-- グループが作成されている場合のみ -->
    <% if @group.present? %>
      <div>
        <h1 class="font-bold text-4xl"><%= @group.name %></h1>
        <p class="text-gray-600 text-gray">n件のタスク</p>
      </div>
    <% end %>

    <button class="btn btn-primary">
      <%= render "shared/icons/plus", class_name: "size-3" %> タスク追加
    </button>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto pb-8">
    <div class="w-2xl mx-auto">
      <ul class="flex flex-col gap-2">
        <% 5.times do |index| %>
          <li
            class="card bg-base-200 w-full border border-neutral"
            role="button"
            id="card-<%= index + 1 %>"
          >
            <div class="card-body gap-3">
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between gap-1">
                  <h1
                    class="
                      card-title min-w-0 flex-1 flex-nowrap gap-2
                      whitespace-nowrap
                    "
                  >
                    <span class="min-w-0 flex-1 truncate">
                      タスクタイトルです、ここは@task.titleに置き換えてください。
                    </span>

                    <div class="badge badge-soft badge-outline badge-primary">
                      <div aria-label="Status" class="status status-primary"></div>
                      完了
                    </div>
                  </h1>

                  <button>編集ボタン</button>
                </div>

                <p class="text-base-content/70">
                  タスクコンテントです、ここは@task.contentに置き換えてください。
                  タスクコンテントです、ここは@task.contentに置き換えてください。
                  タスクコンテントです、ここは@task.contentに置き換えてください。
                  タスクコンテントです、ここは@task.contentに置き換えてください。
                  タスクコンテントです、ここは@task.contentに置き換えてください。
                </p>
              </div>

              <div class="flex items-center gap-1 text-base-content/70">
                <%= render "shared/icons/chat_bubble_left", class_name: "size-3" %>

                <!-- 以下はコメント数をリレーションで所得して渡してください。 -->
                <p class="text-xs">x件のコメント</p>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
