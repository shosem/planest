<div class="h-screen flex flex-col">
  <header class="pt-8 pb-5 w-2xl mx-auto flex justify-between items-center">
    <!-- グループが作成されている場合のみ -->
    <% if @group.present? %>
      <div>
        <h1 class="font-bold text-4xl"><%= @group.name %></h1>
        <p class="text-gray-600 text-gray">n件のタスク</p>
      </div>
    <% end %>

    <button class="btn btn-primary">
      <%= render "shared/icons/plus", class_name: "size-3" %> タスク追加
    </button>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto pb-8">
    <div class="w-2xl mx-auto">
      <ul class="flex flex-col gap-2">
        <% 5.times do |index| %>
          <%= render "tasks/task_card", index: index %>
        <% end %>
      </ul>
    </div>
  </div>
</div>
