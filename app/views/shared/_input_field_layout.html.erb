<% errors = Array(local_assigns[:errors]).compact %>

<%
  # yieldに返すエラークラスを定義
  field_class = errors.any? ? "border-error focus:outline-error" : ""
%>

<div class="flex flex-col gap-1">
  <%= yield(field_class) %>

  <% if errors.any? %>
    <% errors.each do |error| %>
      <p class="text-sm text-error"><%= error %></p>
    <% end %>
  <% end %>
</div>
