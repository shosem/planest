<aside class="h-screen w-55 bg-base-200 flex flex-col border-r border-neutral">
  <div class="p-3">
    <h1>Planest</h1>
  </div>

  <div class="p-3 flex flex-col gap-1.5 border-t border-neutral">
    <%= render "groups/group_section", 
        title: "自分のグループ", 
        groups: [ current_user.personal_group ],
        mode: :personal %>
  </div>

  <div class="p-3 flex flex-col flex-1 gap-1.5 border-t border-neutral">
    <%= render "groups/group_section", 
        title: "グループ", 
        groups: current_user.shared_groups,
        mode: :shared %>
  </div>

  <div class="p-3 flex items-center gap-2.5 border-t border-neutral">
    <div class="avatar avatar-placeholder">
      <div class="bg-neutral text-neutral-content w-8 rounded-full">
        <span><%= current_user.name.first %></span>
      </div>
    </div>

    <span class="font-bold text-sm flex-1"><%= current_user.name %></span>

    <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-circle btn-xs text-base-content/60 p-0 text-xs" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
        />
      </svg>
    <% end %>
  </div>
</aside>
