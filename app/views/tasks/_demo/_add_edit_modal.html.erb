<% mode = local_assigns.fetch(:mode, "add") %>
<% is_edit_mode = mode.to_s == "edit" %>
<% action_title = is_edit_mode ? "タスクを編集" : "タスクを追加" %>
<% action_button_label = is_edit_mode ? "更新する" : "追加する" %>

<dialog id="task_add_edit_modal" class="modal" open>
  <div class="modal-box flex flex-col gap-2">
    <h3 class="text-lg font-bold"><%= action_title %></h3>

    <% if error.present? %>
      <p class="alert alert-error alert-soft">タスクを作成できませんでした</p>
    <% end %>

    <%= form_with local: true, html: { id: "task-add-edit-form", class: "flex flex-col gap-2" } do |f| %>
      <%= render "shared/input_field_section", errors: error do |field_class| %>
        <%= f.label :title, "タイトル", class: "label" %>

        <%= f.text_field :title,
              autocomplete: "off",
              class: "input w-full border #{field_class}",
              placeholder: "タスクのタイトル" %>
      <% end %>

      <% if is_edit_mode %>
        <%= render "shared/input_field_section", errors: error do |field_class| %>
          <%= f.label :status, "ステータス", class: "label" %>

          <%= f.select :status,
                %w[new in_progress done].map { |status| [status, status] },
                {},
                class: "select #{field_class}" %>
        <% end %>
      <% end %>

      <%= render "shared/input_field_section", errors: ["error1", "error2"] do |field_class| %>
        <%= f.label :content, "詳細", class: "label" %>

        <%= f.text_area :content,
              autocomplete: "off",
              class: "textarea w-full #{field_class}",
              placeholder: "詳細や背景情報を入力" %>
      <% end %>
    <% end %>

    <%# .modal-action > <form method="dialog">配下のボタンを押下すると自動でダイアログが閉じる %>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-outline">
          キャンセル
        </button>
      </form>

      <button class="btn btn-primary" type="submit" form="task_add_edit_form">
        <%= action_button_label %>
      </button>
    </div>
  </div>
</dialog>
