<% mode = local_assigns.fetch(:mode, "add") %>
<% is_edit_mode = mode.to_s == "edit" %>
<% action_title = is_edit_mode ? "タスクを編集" : "タスクを追加" %>
<% action_button_label = is_edit_mode ? "更新する" : "追加する" %>

<dialog id="task_add_edit_modal" class="modal" open>
  <div class="modal-box flex flex-col gap-2">
    <h3 class="text-lg font-bold"><%= action_title %></h3>

    <% if error.present? %>
      <p class="alert alert-error alert-soft">タスクを作成できませんでした</p>
    <% end %>

    <form id="task-add-edit-form" class="flex flex-col gap-2" method="post">
      <%= render "shared/input-field-section", label: "タイトル", error: error, input_id: "task-title" do |field_class, input_id| %>
        <input
          type="text"
          id="<%= input_id %>"
          name="title"
          autocomplete="off"
          class="input w-full border <%= field_class %>"
          placeholder="タスクのタイトル"
          defaultValue=""
        >
      <% end %>

      <% if is_edit_mode %>
        <%= render "shared/input-field-section", label: "ステータス", error: error, input_id: "task-status" do |field_class, input_id| %>
          <select class="select <%= field_class %>" name="task-status">
            <% %w[new in_progress done].each do |status| %>
              <option value="<%= status %>">
                <%= render "tasks/_shared/status_badge", status: status %>
              </option>
            <% end %>
          </select>
        <% end %>
      <% end %>

      <%= render "shared/input-field-section", label: "詳細", error: 'error-message', input_id: "task-content" do |field_class, input_id| %>
        <textarea
          type="text"
          id="<%= input_id %>"
          name="content"
          autocomplete="off"
          class="textarea w-full <%= field_class %>"
          placeholder="詳細や背景情報を入力"
          defaultValue=""
        ></textarea>
      <% end %>
    </form>

    <%# .modal-action > <form method="dialog">配下のボタンを押下すると自動でダイアログが閉じる %>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-outline">
          キャンセル
        </button>
      </form>

      <button class="btn btn-primary" type="submit" form="task_add_edit_form">
        <%= action_button_label %>
      </button>
    </div>
  </div>
</dialog>
