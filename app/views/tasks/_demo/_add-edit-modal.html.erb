<dialog id="task_add_edit_modal" class="modal" open>
  <div class="modal-box flex flex-col gap-2">
    <h3 class="text-lg font-bold">タスクを追加</h3>

    <form id="task-add-edit-form" class="flex flex-col gap-2" method="post">
      <%= render "shared/input-field-section", label: "タイトル", error: error, input_id: "task-title" do |field_class, input_id| %>
        <input
          type="text"
          id="<%= input_id %>"
          name="title"
          autocomplete="off"
          class="input w-full border <%= field_class %>"
          placeholder="タスクのタイトル"
          defaultValue=""
        >
      <% end %>

      <%= render "shared/input-field-section", label: "詳細", error: error, input_id: "task-content" do |field_class, input_id| %>
        <textarea
          type="text"
          id="<%= input_id %>"
          name="content"
          autocomplete="off"
          class="textarea w-full <%= field_class %>"
          placeholder="詳細や背景情報を入力"
          defaultValue=""
        ></textarea>
      <% end %>
    </form>

    <%# .modal-action > <form method="dialog">配下のボタンを押下すると自動でダイアログが閉じる %>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-outline">
          キャンセル
        </button>
      </form>

      <button class="btn btn-primary" type="submit" form="task_add_edit_form">
        追加する
      </button>
    </div>
  </div>
</dialog>
