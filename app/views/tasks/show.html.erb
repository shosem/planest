<div class="h-screen flex flex-col">
  <header class="pt-8 w-full flex flex-col gap-2">
    <div class="flex flex-col gap-1 justify-center mx-auto w-2xl">
      <h2 class="font-bold text-2xl flex justify-between items-center">
        タスク名
        <div class="flex gap-2 items-center">
          <div class="tooltip tooltip-bottom tooltip-black tooltip-secondary">
            <div class="tooltip-content">
              タスクを編集
            </div>

            <%= link_to "#edit", class: "btn btn-circle btn-outline btn-secondary" do %>
              <%= render "shared/icons/pencil_square" %>
            <% end %>
          </div>

          <div class="tooltip tooltip-bottom tooltip-black tooltip-error">
            <div class="tooltip-content">
              タスクを削除
            </div>

            <%= link_to "#edit", class: "btn btn-circle btn-error btn-outline" do %>
              <%= render "shared/icons/trash" %>
            <% end %>
          </div>
        </div>
      </h2>

      <%= render "tasks/_shared/status_badge", status: :in_progress %>
    </div>
  </header>

  <div class="divider divider-neutral"></div>

  <div class="flex-1 min-h-0 overflow-y-auto pb-8">
    <section class="flex flex-col gap-1 justify-center mx-auto w-2xl">
      <h3 class="text-base-content/70">説明</h3>
      <p>コンテンツコンテンツコンテンツコンテンツコンテンツコンテンツコンテンツコンテンツコンテンツ</p>
    </section>

    <div class="divider divider-neutral"></div>

    <section class="w-2xl mx-auto flex flex-col gap-1">
      <h3 class="text-base-content/70">
        コメント <span class="text-info">(2)</span>
      </h3>

      <div class="flex flex-col gap-4">
        <% 20.times do |index| %>
          <%= render "tasks/comment" %>
        <% end %>
      </div>
    </section>
  </div>

  <footer class="px-5 py-4 border-t border-neutral">
    <%= form_with local: true, html: { id: "task-add-edit-form", class: "flex gap-2 items-end" } do |f| %>
      <%= f.text_area :title,
          autocomplete: "off",
          class: "input w-full flex-1 border textarea",
          placeholder: "コメントを入力" %>

      <%= f.submit class: "btn btn-primary" %>
    <% end %>
  </footer>
</div>
