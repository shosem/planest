<div class="h-screen flex flex-col">
  <header class="pt-8 pb-4 w-full flex flex-col gap-3">
    <div class="flex flex-col gap-1 justify-center mx-auto w-2xl">
      <h2 class="font-bold text-2xl flex justify-between items-center">
        <%= @task.title %>

        <%# 自分のタスクのみ編集と削除の動線を表示する %>
        <% if @task.user_id == current_user.id %>
          <div class="flex gap-2 items-center">
            <div class="tooltip tooltip-bottom tooltip-black tooltip-secondary">
              <div class="tooltip-content">
                タスクを編集
              </div>

              <%= link_to edit_task_path(@task), data: {turbo_frame: "modal"}, class: "btn btn-circle btn-outline btn-secondary" do %>
                <%= render "shared/icons/pencil_square" %>
              <% end %>
            </div>

            <div class="tooltip tooltip-bottom tooltip-black tooltip-error">
              <div class="tooltip-content">
                タスクを削除
              </div>

              <%= button_to task_path(@task), method: :delete, data: { turbo_confirm: "本当に削除しますか？"}, class: "btn btn-circle btn-error btn-outline" do %>
                <%= render "shared/icons/trash" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </h2>

      <%= render "tasks/shared/status_badge", status: @task.status %>
    </div>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto pb-8">
    <div class="border-t border-neutral">
      <section class="flex flex-col gap-1 justify-center mx-auto w-2xl py-4">
        <h3 class="text-base-content/70">説明</h3>
        <p class="whitespace-pre-line"><%= @task.description %></p>
      </section>
    </div>

    <div class="border-t border-neutral">
      <section class="w-2xl mx-auto flex flex-col gap-1 py-4">
        <h3 class="text-base-content/70">
          コメント <span id="comments_count" class="text-info">(<%= @comments.count %>)</span>
        </h3>
        <div id="comments" class="flex flex-col gap-4">
          <% @comments.each do |comment| %>
            <%= render "tasks/comment", comment: comment %>
          <% end %>
        </div>
      </section>
    </div>
  </div>

  <footer class="px-5 py-4 border-t border-neutral">
    <%= form_with model: [@task, Comment.new], html: { id: "comment_form", class: "flex gap-2 items-end" } do |f| %>
      <%= f.text_area :content,
          autocomplete: "off",
          class: "input w-full flex-1 border textarea",
          placeholder: "コメントを入力" %>

      <%= f.submit "送信", class: "btn btn-primary" %>
    <% end %>
  </footer>
</div>
