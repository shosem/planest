<%# locals: (group:nil, task:) %>

<dialog id="task_add_edit_modal" class="modal" open>
  <div class="modal-box flex flex-col gap-2">
    <h3 class="text-lg font-bold"><%= task.persisted? ? "タスクを編集" : "タスクを追加" %></h3>

    <% if error.present? %>
      <p class="alert alert-error alert-soft">タスクを作成できませんでした</p>
    <% end %>

    <%= render "tasks/task_form", group: group, task: task %>
  </div>
</dialog>
