# --- データベース接続 ---
DATABASE_URL=postgres://postgres:password@db:5432/app_development
TEST_DATABASE_URL=postgres://postgres:password@db:5432/app_test

# --- システムテスト（RSpec + Capybara）用 ---
SELENIUM_DRIVER_URL=http://chrome:4444/wd/hub

# --- その他 ---
THOR_SILENCE_DEPRECATION=true

# --- ポート設定 ---
# ホスト側のポートが他のアプリと衝突する場合のみ、コメントを外して変更してください。
# 未設定なら compose.yml の既定値（web:3000 / db:5432）が使われます。
# WEB_PORT=3000
# DB_PORT=5432